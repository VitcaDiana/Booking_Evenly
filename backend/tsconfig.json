{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    
    /* Paths & Resolution */
    "paths": {
      "@app/*": ["./app/*"],
      "@lib/*": ["./lib/*"],
      "src/*": ["./src/*"]
    },
    
    /* Strictness & Checks */
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    
    /* Interop & Features */
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    /* Build Performance */
    "incremental": true,
    "removeComments": true,
    "declaration": true,
    "sourceMap": true
  }
}