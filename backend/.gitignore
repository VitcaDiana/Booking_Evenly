# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS files
desktop.ini
.DS_Store

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# NestJS / TypeScript compilation output
/dist
/build
*.tsbuildinfo

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables (CRITICAL pentru backend - nu urca parole/chei API)
.env
.env.development
.env.production
.env.local
.env.*.local

# Security certificates
*.pem

# IDEs and editors
.vscode/
.idea/